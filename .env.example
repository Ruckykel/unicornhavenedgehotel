# Public site URL (used for canonical URLs, sitemap, Paystack callback)
NEXT_PUBLIC_SITE_URL=https://www.unicornhavenedgehotel.com

# Paystack (https://dashboard.paystack.com/#/settings/developers)
# Leave empty to hide "Pay now" and accept "Pay at hotel" requests only.
PAYSTACK_SECRET_KEY=

# Resend (https://resend.com) — without a key, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="Unicorn Haven Edge Hotel <reservations@unicornhavenedgehotel.com>"
RESERVATIONS_EMAIL=reservations@unicornhavenedgehotel.com

# Signs booking confirmation links. Use a long random string in production.
BOOKING_SECRET=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
